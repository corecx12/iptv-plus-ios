<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===== Seite mit großem Titelbild und waagerechten Reihen ===== -->
    <FrameLayout
        android:id="@+id/pageShelves"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">
        <ImageView
            android:id="@+id/heroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <View
            android:id="@+id/heroScrimLeft"
            android:layout_width="640dp"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />
        <View
            android:id="@+id/heroScrimBottom"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/scrim_top" />
        <LinearLayout
            android:id="@+id/heroInfo"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="92dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">
            <TextView
                android:id="@+id/heroKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted" />
            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#E5E5EA" />
            <TextView
                android:id="@+id/heroPlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="3"
                android:textColor="@color/muted" />
            <LinearLayout
                android:id="@+id/heroButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelvesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="40dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/shelvesMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/muted"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Listen-Seite: Kategorie-Spalte + Inhalt (Alle anzeigen, TV-Programm, Einstellungen) ===== -->
    <LinearLayout
        android:id="@+id/pageList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="92dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/colCats"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingEnd="18dp">
            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/field_bg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="In Kategorie suchen"
                android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/cell_text"
                android:textColorHint="@color/cell_sub"
                android:textSize="15sp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/colMain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/listBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
            <ScrollView
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/settingsBox"
                    android:layout_width="640dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Suche ===== -->
    <LinearLayout
        android:id="@+id/pageSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="96dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/globalSearch"
            android:layout_width="560dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/field_bg"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Filme, Serien und Sender"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/cell_text"
            android:textColorHint="@color/cell_sub"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/searchMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchShelves"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ===== Kopfzeile: Logo + Reiterleiste (Glas) ===== -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp">
        <TextView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:textColor="@color/text" />
        <LinearLayout
            android:id="@+id/nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tabbar_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp" />
    </FrameLayout>

    <!-- ===== Detailseite für Filme und Serien ===== -->
    <FrameLayout
        android:id="@+id/detailPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clipChildren="false"
        android:elevation="8dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/detailBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <View
            android:layout_width="720dp"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />
        <View
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />
        <LinearLayout
            android:id="@+id/detailInfo"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="56dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">
            <TextView
                android:id="@+id/detailKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted" />
            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/detailMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#E5E5EA" />
            <TextView
                android:id="@+id/detailPlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="4"
                android:textColor="#D1D1D6" />
            <LinearLayout
                android:id="@+id/detailButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/detailSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="18dp"
            android:visibility="gone">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/seasonTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="44dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodesView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="48dp"
                android:paddingTop="6dp"
                android:paddingEnd="48dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Player ===== -->
    <FrameLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:elevation="16dp"
        android:visibility="gone">
        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/videoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />
        <TextView
            android:id="@+id/playerMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/pauseBadge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/pause_badge"
            android:gravity="center"
            android:text="❚❚"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- Leiste unten: Titel, Zeitleiste, Zeiten -->
        <LinearLayout
            android:id="@+id/infoOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="80dp"
            android:paddingEnd="48dp"
            android:paddingBottom="30dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/infoKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted" />
            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/infoNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E5E5EA" />
            <ProgressBar
                android:id="@+id/infoProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_white" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/infoTimeL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:textColor="#E5E5EA" />
                <TextView
                    android:id="@+id/infoHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/infoTimeR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="#E5E5EA" />
            </FrameLayout>
        </LinearLayout>

        <!-- Panel oben: Info / Audio / Untertitel -->
        <LinearLayout
            android:id="@+id/topPanel"
            android:layout_width="720dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="27dp"
            android:background="@drawable/overlay_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/panelTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/tabbar_bg"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="4dp" />
            <LinearLayout
                android:id="@+id/panelBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hinweis-Banner oben (statt Toasts) -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/banner_bg"
        android:elevation="24dp"
        android:maxWidth="640dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:visibility="gone" />
</FrameLayout>
